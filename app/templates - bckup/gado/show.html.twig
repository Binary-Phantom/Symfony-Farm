<!DOCTYPE html>

<title>Gado</title>

{% block body %}
    <h1>Gado</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ gado.id }}</td>
            </tr>
            <tr>
                <th>Codigo</th>
                <td>{{ gado.codigo }}</td>
            </tr>
            <tr>
                <th>LeiteSemana</th>
                <td>{{ gado.leiteSemana }}</td>
            </tr>
            <tr>
                <th>RacaoSemana</th>
                <td>{{ gado.racaoSemana }}</td>
            </tr>
            <tr>
                <th>Peso</th>
                <td>{{ gado.peso }}</td>
            </tr>
            <tr>
                <th>Nascimento</th>
                <td>{{ gado.nascimento ? gado.nascimento|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Abatido</th>
                <td>{{ gado.abatido ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_gado_index') }}">back to list</a>

    <a href="{{ path('app_gado_edit', {'id': gado.id}) }}">edit</a>

    {{ include('gado/_delete_form.html.twig') }}
{% endblock %}
