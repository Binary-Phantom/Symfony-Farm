{% extends 'layout/base.html.twig' %}

{% block body %}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">

            Rebanho Ativo

        </h1>

        <p class="text-muted mb-0">

            Controle completo dos animais vivos da fazenda.

        </p>

    </div>

    <div class="d-flex gap-2 mt-3 mt-lg-0">


        <a
            href="{{ path('app_gado_abatidos') }}"
            class="btn btn-danger"
        >
            Gados Abatidos
        </a>

        <a
            href="{{ path('app_gado_new') }}"
            class="btn btn-success"
        >
            Novo Gado
        </a>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>
                        <th>Código</th>
                        <th>Peso</th>
                        <th>Idade</th>
                        <th>Leite</th>
                        <th>Ração</th>
                        <th>Fazenda</th>
                        <th>Ações</th>
                    </tr>

                </thead>

                <tbody>

                {% for gado in pagination %}

                    <tr>

                        <td>{{ gado.codigo }}</td>

                        <td>

                            {{ gado.peso }} Kg
<br>

                            <small class="text-muted">

                                {{ (gado.peso / 15)|number_format(1, ',', '.') }} @

                            </small>

                        </td>


                        <td>

    {% set idade = date().diff(gado.nascimento) %}

    <span class="badge bg-info text-dark p-2">

        {{ idade.y }}

                                 {% if idade.y == 1 %}
                                    ano
                                 {% else %}
                                    anos
                                {% endif %}

                                    {{ idade.m }}

                                    {% if idade.m == 1 %}
                                        mês
                                    {% else %}
                                         meses
                                    {% endif %}

                                        e

                                    {{ idade.d }}

                                    {% if idade.d == 1 %}
                                        dia
                                    {% else %}
                                        dias
                                {% endif %}

                            </span>

                        </td>



                        <td>{{ gado.leiteSemana }} L</td>

                        <td>{{ gado.racaoSemana }} Kg</td>

                        <td>{{ gado.fazenda.nome }}</td>

                        <td class="d-flex gap-2">

                            <a
                                href="{{ path('app_gado_show', {
                                    id: gado.id
                                }) }}"
                                class="btn btn-info btn-sm"
                            >
                                Ver
                            </a>

                            <a
                                href="{{ path('app_gado_edit', {
                                    id: gado.id
                                }) }}"
                                class="btn btn-warning btn-sm"
                            >
                                Editar
                            </a>

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}