{% extends 'layout/base.html.twig' %}

{% block title %}
Fazendas
{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold">

            Fazendas

        </h1>

        <p class="text-muted">

            Gerenciamento das propriedades.

        </p>

    </div>

    <div class="d-flex gap-2">

        <a
            href="{{ path('app_fazenda_resumo') }}"
            class="btn btn-primary"
        >
            Resumo
        </a>

        <a
            href="{{ path('app_fazenda_new') }}"
            class="btn btn-success"
        >
            Nova Fazenda
        </a>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Tamanho</th>
                        <th>Responsável</th>
                        <th>Veterinário(s)</th>
                        <th class="text-end">Ações</th>
                    </tr>

                </thead>

                <tbody>

                {% for fazenda in pagination %}

                    <tr>

                        <td>

                            {{ fazenda.id }}

                        </td>

                        <td>

                            {{ fazenda.nome }}

                        </td>

                        <td>

                            {{ fazenda.tamanho }} HA

                        </td>

                        <td>

                            {{ fazenda.responsavel }}

                        </td>

                        <td>

                            {% for veterinario in fazenda.veterinarios %}

                                <span class="badge bg-primary mb-1">

                                    {{ veterinario.nome }}

                                    -

                                    CRMV: {{ veterinario.crmv }}

                                </span>

                                <br>

                            {% else %}

                                <span class="text-muted">

                                    Nenhum veterinário

                                </span>

                            {% endfor %}

                        </td>

                        <td class="text-end">

                            <div class="d-flex justify-content-end">

                                {% include 'components/table-actions.html.twig' with {

                                    show_path: path(
                                        'app_fazenda_show',
                                        {id: fazenda.id}
                                    ),

                                    edit_path: path(
                                        'app_fazenda_edit',
                                        {id: fazenda.id}
                                    ),

                                    delete_path: path(
                                        'app_fazenda_delete',
                                        {id: fazenda.id}
                                    ),

                                    csrf_token: csrf_token(
                                        'delete' ~ fazenda.id
                                    )

                                } %}

                            </div>

                        </td>

                    </tr>

                {% else %}

                    <tr>

                        <td colspan="6" class="text-center">

                            Nenhuma fazenda encontrada.

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

        {% include 'pagination.html.twig' with {'pagination': pagination} %}

    </div>

</div>

{% endblock %}