<div class="d-flex justify-content-end gap-2 flex-wrap">

    <a
        href="{{ show_path }}"
        class="btn btn-sm btn-action btn-show"
    >
        Ver
    </a>

    <a
        href="{{ edit_path }}"
        class="btn btn-sm btn-action btn-edit"
    >
        Editar
    </a>

    <form
        method="post"
        action="{{ delete_path }}"
        onsubmit="return confirm('Deseja realmente excluir?');"
    >

        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token }}"
        >

        <button
            type="submit"
            class="btn btn-sm btn-action btn-delete"
        >
            Excluir
        </button>

    </form>

</div>