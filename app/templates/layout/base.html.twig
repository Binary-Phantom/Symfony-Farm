<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>

        {% block title %}
            Symfony Farm
        {% endblock %}

    </title>

    {{ encore_entry_link_tags('app') }}

</head>

<body class="bg-light">

    {% include 'components/navbar.html.twig' %}

    <div class="container-fluid">

        <div class="row">

            <div class="col-lg-2 p-0">

                {% include 'components/sidebar.html.twig' %}

            </div>

            <div class="col-lg-10 p-4">

                {% include 'components/alerts.html.twig' %}

                {% block body %}
                {% endblock %}

            </div>

        </div>

    </div>

    {{ encore_entry_script_tags('app') }}

    <style>

        /*
         * Botões padrão das tabelas
         */
        .btn-action {

            border: none;

            border-radius: 12px;

            padding: 6px 14px;

            font-weight: 600;

            transition: all 0.25s ease;

            box-shadow: 0 2px 6px rgba(0,0,0,0.08);

        }

        .btn-action:hover {

            transform: translateY(-2px);

            box-shadow: 0 6px 14px rgba(0,0,0,0.12);

        }

        /*
         * Botão Ver
         */
        .btn-show {

            background: #eef2ff;

            color: #4f46e5;

        }

        .btn-show:hover {

            background: #4f46e5;

            color: white;

        }

        /*
         * Botão Editar
         */
        .btn-edit {

            background: #ecfeff;

            color: #0891b2;

        }

        .btn-edit:hover {

            background: #0891b2;

            color: white;

        }

        /*
         * Botão Excluir
         */
        .btn-delete {

            background: #fee2e2;

            color: #dc2626;

        }

        .btn-delete:hover {

            background: #dc2626;

            color: white;

        }

    </style>

</body>

</html>