{% for label, messages in app.flashes %}

    {% for message in messages %}

        <div
            class="alert

            {% if label == 'success' %}
                alert-success

            {% elseif label == 'danger' or label == 'error' %}
                alert-danger

            {% elseif label == 'warning' %}
                alert-warning

            {% else %}
                alert-info
            {% endif %}

            alert-dismissible fade show shadow-sm"
            role="alert"
        >

            <div class="d-flex align-items-center justify-content-between">

                <span>

                    {{ message }}

                </span>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        </div>

    {% endfor %}

{% endfor %}