{# templates/dashboard/index.html.twig #}

{% extends 'layout/base.html.twig' %}

{% block title %}
Dashboard
{% endblock %}

{% block body %}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">

    <div>

        <h1 class="fw-bold mb-1 text-success">

            Dashboard das Fazendas

        </h1>

        <p class="text-muted mb-0">

            Controle geral da produção e monitoramento do rebanho.

        </p>

    </div>

    <div class="mt-3 mt-lg-0">

        <span class="badge bg-success fs-6 shadow-sm p-3">

            Sistema Online

        </span>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-md-6 col-xl-3">

        <div class="card border-0 shadow-lg h-100 dashboard-card">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">

                            Produção de Leite

                        </p>

                        <h2 class="fw-bold text-success">

                            {{ totalLeite }} L

                        </h2>

                    </div>

                    <div class="dashboard-icon bg-success-subtle text-success">

                        🥛

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-6 col-xl-3">

        <div class="card border-0 shadow-lg h-100 dashboard-card">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">

                            Consumo de Ração

                        </p>

                        <h2 class="fw-bold text-warning">

                            {{ totalRacao }} Kg

                        </h2>

                    </div>

                    <div class="dashboard-icon bg-warning-subtle text-warning">

                        🌾

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-6 col-xl-3">

        <div class="card border-0 shadow-lg h-100 dashboard-card">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">

                            Animais Jovens de Alto Consumo

                        </p>

                        <h2 class="fw-bold text-primary">

                            {{ totalAnimaisJovens }}

                        </h2>

                    </div>

                    <div class="dashboard-icon bg-primary-subtle text-primary">

                        🐄

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-6 col-xl-3">

        <div class="card border-0 shadow-lg h-100 dashboard-card">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">

                            Animais Elegíveis para Abate

                        </p>

                        <h2 class="fw-bold text-danger">

                            {{ totalAbate }}

                        </h2>

                    </div>

                    <div class="dashboard-icon bg-danger-subtle text-danger">

                        ⚠️

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-xl-8">

        <div class="card border-0 shadow-lg h-100">

            <div class="card-header bg-white border-0 pt-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h4 class="fw-bold mb-1">

                            Resumo das Fazendas

                        </h4>

                        <p class="text-muted mb-0">

                            Visão geral das propriedades cadastradas

                        </p>

                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table align-middle table-hover">

                        <thead class="table-light">

                            <tr>

                                <th>Fazenda</th>
                                <th>Responsável</th>
                                <th>Hectares</th>
                                <th>Qtd. Gados</th>

                            </tr>

                        </thead>

                        <tbody>

                            {% for fazenda in fazendasPagination %}

                            <tr>

                                <td>

                                    <div class="fw-semibold">

                                        {{ fazenda.nome }}

                                    </div>

                                </td>

                                <td>

                                    {{ fazenda.responsavel }}

                                </td>

                                <td>

                                    <span class="badge bg-success">

                                        {{ fazenda.tamanho }} HA

                                    </span>

                                </td>

                                <td>

                                    <span class="badge bg-dark">

                                        {{ fazenda.gados }}

                                    </span>

                                </td>

                            </tr>

                        {% else %}

                            <tr>

                                <td colspan="4">

                                    Nenhuma fazenda cadastrada.

                                </td>

                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

                <div class="d-flex justify-content-center mt-4">

                    {{ knp_pagination_render(fazendasPagination) }}

                </div>

        </div>

    <div class="col-12 col-xl-4">

        <div class="card border-0 shadow-lg h-100">

            <div class="card-header bg-white border-0 pt-4">

                <h4 class="fw-bold">

                    Atalhos Rápidos

                </h4>

            </div>

            <div class="card-body d-grid gap-3">

                <a
                    href="{{ path('app_gado_new') }}"
                    class="btn btn-success btn-lg shadow-sm"
                >
                    + Novo Gado
                </a>

                <a
                    href="{{ path('app_fazenda_new') }}"
                    class="btn btn-warning btn-lg shadow-sm"
                >
                    + Nova Fazenda
                </a>

                <a
                    href="{{ path('app_veterinario_new') }}"
                    class="btn btn-primary btn-lg shadow-sm"
                >
                    + Novo Veterinário
                </a>

                <a
                    href="{{ path('app_gado_index') }}"
                    class="btn btn-dark btn-lg shadow-sm"
                >
                    Ver Rebanho
                </a>

            </div>

        </div>

    </div>

</div>

<div class="row g-4">

    <div class="col-12">

        <div class="card border-0 shadow-lg">

            <div class="card-header bg-white border-0 pt-4">

                <h4 class="fw-bold text-danger">

                    Animais Elegíveis para Abate

                </h4>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Código</th>
                                <th>Peso</th>
                                <th>Leite</th>
                                <th>Ração</th>
                                <th>Fazenda</th>

                            </tr>

                        </thead>

                        <tbody>

                        {% for gado in abatePagination %}

                            <tr>

                                <td>

                                    <strong>

                                        #{{ gado.codigo }}

                                    </strong>

                                </td>

                                <td>

                                    {{ gado.peso }} Kg

                                    <br>

                                        <small class="text-muted">

                                            {{ (gado.peso / 15)|number_format(1, ',', '.') }} @

                                        </small>
                                </td>

                                <td>

                                    {{ gado.leiteSemana }} L

                                </td>

                                <td>

                                    {{ gado.racaoSemana }} Kg

                                </td>

                                <td>

                                    {{ gado.fazenda.nome }}

                                </td>

                            </tr>

                        {% else %}

                            <tr>

                                <td colspan="5">

                                    Nenhum animal disponível para abate.

                                </td>

                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>
                        {% include 'components/pagination.html.twig' %}


            </div>

        </div>

    </div>

    </div>

<style>

.dashboard-card {
    transition: all 0.3s ease;
    border-radius: 20px;
}

.dashboard-card:hover {
    transform: translateY(-5px);
}

.dashboard-icon {

    width: 70px;
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 18px;

    font-size: 30px;
}

.card {
    border-radius: 20px;
}

.table thead th {
    border: none;
}

</style>

{% endblock %}